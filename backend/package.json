{
  "name": "cybershield-backend",
  "version": "1.0.0",
  "description": "MERN backend for CyberShield cybersecurity awareness platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "predev": "npm run stop",
    "dev": "nodemon server.js",
    "stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-port.ps1 5000",
    "restart": "npm run stop && npm run dev",
    "seed": "node seed.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
